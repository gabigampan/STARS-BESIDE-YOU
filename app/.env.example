# Copy to .env.local and fill in. Never commit .env.local.
# Cesium ion access token (https://ion.cesium.com/tokens). Optional: without it the app uses key-free NASA imagery and no terrain.
VITE_CESIUM_ION_TOKEN=
# Set to 1 to use the token (Cesium World Terrain, Bing aerial imagery, Cesium Moon). Leave unset for the key-free deploy.
VITE_USE_ION=
